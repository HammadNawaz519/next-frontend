generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                 String    @id @default(cuid())
  name               String?
  username           String?   @unique
  email              String?   @unique
  emailVerified      DateTime?
  image              String?
  password           String?
  phone              String?
  createdAt          DateTime  @default(now())
  bio                String?
  website            String?
  isPrivate          Boolean   @default(false)
  lastSeen           DateTime?
  isOnline           Boolean   @default(false)
  lastHeartbeat      DateTime?
  showActivityStatus Boolean   @default(true)

  accounts Account[]
  sessions Session[]
  messages Message[]
  translationHistory TranslationHistory[]

  sentSocialMessages     SocialMessage[] @relation("SentMessages")
  receivedSocialMessages SocialMessage[] @relation("ReceivedMessages")
  socialReactions        SocialReaction[]
  hiddenSocialChats      HiddenSocialChat[] @relation("HiddenChats")
  hiddenFromSocialChats  HiddenSocialChat[] @relation("HiddenByChats")

  callsMade     SocialCall[] @relation("CallsMade")
  callsReceived SocialCall[] @relation("CallsReceived")

  // Social Connections
  followers User[] @relation("UserFollows")
  following User[] @relation("UserFollows")

  sentFollowRequests     FollowRequest[] @relation("SentFollowRequests")
  receivedFollowRequests FollowRequest[] @relation("ReceivedFollowRequests")

  // Posts
  // Posts
  posts      Post[]
  likes      Like[]
  comments   Comment[]
  savedPosts SavedPost[]
  stories    Story[]

  // Accounts Center Relations
  profileSync     ProfileSyncSetting?
  securitySetting SecuritySetting?
  activeSessions  ActiveSession[]
  searchHistories SearchHistory[]
  offPlatformLogs OffPlatformActivity[]
  dataExports     DataExportJob[]
  adPreference    AdPreference?
  paymentTokens   PaymentVaultToken[]
  vaultAddresses  VaultAddress[]
}

model TranslationHistory {
  id        String   @id @default(cuid())
  userId    String
  text      String   @db.Text
  language  String   @default("en")
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model SocialMessage {
  id                  String   @id @default(cuid())
  content             String   @db.Text
  type                String   @default("text") // "text", "image", "video", "voice", "deleted"
  senderId            String
  receiverId          String
  createdAt           DateTime @default(now())
  isSeen              Boolean  @default(false)
  seenAt              DateTime?
  deletedBySender     Boolean  @default(false)
  deletedByReceiver   Boolean  @default(false)

  // Reply-to metadata (persisted so quoted preview survives refresh)
  replyToId           String?  @db.Text
  replyToContent      String?  @db.Text
  replyToSenderName   String?

  sender    User             @relation("SentMessages", fields: [senderId], references: [id], onDelete: Cascade)
  receiver  User             @relation("ReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  reactions SocialReaction[]

  @@index([senderId, receiverId, createdAt])
  @@index([receiverId, senderId, createdAt])
  @@index([receiverId, isSeen])
}

model SocialReaction {
  id        String   @id @default(cuid())
  emoji     String
  userId    String
  messageId String
  message   SocialMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, messageId, emoji])
}

model HiddenSocialChat {
  id           String   @id @default(cuid())
  userId       String
  hiddenUserId String
  createdAt    DateTime @default(now())

  user       User @relation("HiddenChats", fields: [userId], references: [id], onDelete: Cascade)
  hiddenUser User @relation("HiddenByChats", fields: [hiddenUserId], references: [id], onDelete: Cascade)

  @@unique([userId, hiddenUserId])
}

model Message {
  id        String   @id @default(cuid())
  content   String   @db.Text
  role      String   // 'user' or 'ai'
  createdAt DateTime @default(now())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PendingUser {
  id           String   @id @default(cuid())
  email        String   @unique
  username     String?
  phone        String?
  password     String
  verifyCode   String
  verifyExpiry DateTime
  createdAt    DateTime @default(now())
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model SocialCall {
  id         String   @id @default(cuid())
  callerId   String
  receiverId String
  type       String   // "audio" or "video"
  status     String   // "missed", "completed", "rejected"
  duration   Int?     // in seconds
  createdAt  DateTime @default(now())

  caller   User @relation("CallsMade", fields: [callerId], references: [id], onDelete: Cascade)
  receiver User @relation("CallsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
}

model FollowRequest {
  id         String   @id @default(cuid())
  senderId   String
  receiverId String
  createdAt  DateTime @default(now())

  sender   User @relation("SentFollowRequests", fields: [senderId], references: [id], onDelete: Cascade)
  receiver User @relation("ReceivedFollowRequests", fields: [receiverId], references: [id], onDelete: Cascade)

  @@unique([senderId, receiverId])
}

model Post {
  id           String   @id @default(cuid())
  thumbnailUrl String?
  imageUrl     String?
  caption      String?
  postType     String   // "single_image", "carousel", "reel"
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt    DateTime @default(now())

  likes      Like[]
  comments   Comment[]
  savedPosts SavedPost[]
}

model Like {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Comment {
  id        String   @id @default(cuid())
  content   String   @db.Text
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model SavedPost {
  id        String   @id @default(cuid())
  postId    String
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([postId, userId])
}

model Story {
  id        String   @id @default(cuid())
  imageUrl  String
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

// ==========================================
// ACCOUNTS CENTER FEDERATED MODULES
// ==========================================

model ProfileSyncSetting {
  id           String   @id @default(cuid())
  userId       String   @unique
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  syncPolicy   String   @default("FULL_SYNC") // "FULL_SYNC", "AVATAR_ONLY", "MANUAL"
  syncName     Boolean  @default(true)
  syncBio      Boolean  @default(true)
  syncAvatar   Boolean  @default(true)
  lastSyncedAt DateTime @default(now())
}

model CrossPostConfig {
  id              String   @id @default(cuid())
  userId          String
  targetPlatform  String   // "INSTAGRAM", "FACEBOOK", "THREADS"
  autoPostStories Boolean  @default(false)
  autoPostFeed    Boolean  @default(false)
  autoPostReels   Boolean  @default(false)

  @@unique([userId, targetPlatform])
}

model SecuritySetting {
  id                 String   @id @default(cuid())
  userId             String   @unique
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  isTwoFactorEnabled Boolean  @default(false)
  totpSecret         String?
  backupCodes        String[] @default([])
  loginAlertsEmail   Boolean  @default(true)
  loginAlertsPush    Boolean  @default(true)
}

model ActiveSession {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sessionToken    String   @unique
  deviceName      String   @default("Mobile App")
  deviceOs        String   @default("iOS / Android")
  ipAddress       String   @default("127.0.0.1")
  locationCity    String   @default("San Francisco")
  locationCountry String   @default("United States")
  lastActiveAt    DateTime @default(now())
  isCurrent       Boolean  @default(false)
}

model SearchHistory {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform       String   @default("INSTAGRAM")
  query          String
  targetEntityId String?
  searchedAt     DateTime @default(now())
}

model OffPlatformActivity {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  partnerName    String
  appOrDomain    String
  eventType      String
  eventTimestamp DateTime @default(now())
  isCleared      Boolean  @default(false)
}

model DataExportJob {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exportFormat String   @default("JSON")
  status       String   @default("PENDING") // "PENDING", "PROCESSING", "COMPLETED"
  downloadUrl  String?
  requestedAt  DateTime @default(now())
}

model AdPreference {
  id                    String   @id @default(cuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  sensitiveTopicsHidden String[] @default(["Gambling", "Politics"])
  usePartnerData        Boolean  @default(true)
  personalizedAds       Boolean  @default(true)
}

model PaymentVaultToken {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String   @default("STRIPE")
  vaultedTokenId String
  cardLast4      String
  cardBrand      String
  expiryMonth    Int
  expiryYear     Int
  isDefault      Boolean  @default(false)
  createdAt      DateTime @default(now())
}

model VaultAddress {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  recipientName String
  streetAddress String
  city          String
  state         String
  postalCode    String
  country       String   @default("United States")
  isDefault     Boolean  @default(false)
}
